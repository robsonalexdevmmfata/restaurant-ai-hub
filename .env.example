# URL de um proxy servidor-side que valida o tenant e usa credenciais Evolution fora do browser.
# Sem valor, as notificações ficam marcadas como simuladas no estado operacional.
VITE_EVOLUTION_NOTIFICATION_PROXY_URL=

# API acessível pelo telefone que escaneia o QR. Para LAN, substitua localhost pelo IP do servidor.
VITE_API_BASE_URL=http://localhost:3001

# URL pública do frontend usado nos QR Codes. Em testes via celular, use o IP local da máquina.
VITE_PUBLIC_APP_URL=

# URL acessível pelo dispositivo que abre o QR Code. Em celulares, use o IP da máquina/servidor na rede.
VITE_API_BASE_URL=http://localhost:3001
