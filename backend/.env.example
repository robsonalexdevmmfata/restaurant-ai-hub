PORT=3001
DATABASE_URL=postgresql://admin:123456@localhost:5432/restaurante
JWT_SECRET=restauranteai-jwt-dev-secret-change-in-prod
API_SECRET=dev-secret-change-me

# Configure both values to enable customer WhatsApp notifications.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# For local testing, use the n8n test URL while the workflow is listening.
# In production, use the active workflow URL (/webhook/...), not /webhook-test/.
N8N_EVOLUTION_WEBHOOK_URL=

# WhatsApp AI agent: create a long random token and keep every secret server-side.
# Evolution must be able to reach PUBLIC_API_URL (do not use localhost in containers).
EVOLUTION_WEBHOOK_TOKEN=
GROK_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning
PUBLIC_API_URL=
PUBLIC_APP_URL=
